# Only the URL/function endpoint may be embedded in the private WebApp page;
# never put the bot token, service role key, or a real user ID in browser code.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_FUNCTION_URL=https://YOUR_PROJECT.supabase.co/functions/v1/portfolio-data
SUPABASE_SERVICE_ROLE_KEY=SET_ONLY_IN_GITHUB_ACTIONS_SECRET
PORTFOLIO_USER_ID=SET_TO_AUTH_USERS_UUID
TELEGRAM_BOT_TOKEN=SET_ONLY_IN_SUPABASE_SECRET
TELEGRAM_ALLOWED_USER_ID=SET_TO_TELEGRAM_USER_ID
SUPABASE_PRIVATE_SYNC_REQUIRED=false
FORM_SCHEMA_STRICT=true
# Temporary migration bridge for the existing legacy asset Form. Disable after
# the Form response sheet has the fixed transaction schema.
FORM_SCHEMA_LEGACY_COMPAT=false
